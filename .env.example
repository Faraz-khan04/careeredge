# ---- Database -------------------------------------------------------------
# Neon / Supabase / any Postgres. Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://user:password@host/careeredge?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/careeredge?sslmode=require"

# ---- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Monetization ---------------------------------------------------------
# Comma-separated affiliate tags appended to partner outbound links.
NEXT_PUBLIC_AFFILIATE_TAG="careeredge"
# Toggle the Pro blur layer off in development.
NEXT_PUBLIC_PRO_PAYWALL_ENABLED="true"
