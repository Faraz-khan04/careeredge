// CareerEdge — PostgreSQL schema
// Provider notes: `directUrl` is required by Neon/Supabase pooled connections
// so that `prisma migrate` bypasses PgBouncer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlanTier {
  FREE
  PRO
  TEAM
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED // work email or payslip verified — unlocks the role badge
  REJECTED
}

enum PostTag {
  OFFER_REVIEW
  SALARY_TRANSPARENCY
  INTERVIEW_EXPERIENCE
  SKILL_ROADMAP
  REMOTE_WORK_LIFE
}

enum CalculatorType {
  SKILL_ARBITRAGE
  REMOTE_PAY_EQUITY
}

enum VoteValue {
  UP
  DOWN
}

enum ModerationState {
  PUBLISHED
  FLAGGED // caught by PII / profanity heuristics, hidden pending review
  REMOVED
}

enum EmploymentStructure {
  FULL_TIME
  CONTRACTOR
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id       String @id @default(cuid())
  email    String @unique
  // Pseudonymous handle shown on non-anonymous posts. Never the real name.
  handle   String @unique
  imageUrl String?

  // Profile — powers the verified role badge, e.g. "Senior Backend | 5 YOE"
  headline           String?
  currentRole        String?
  yearsExperience    Int?
  currentCompanySize String?
  city               String?
  countryCode        String? @db.Char(2)
  currencyCode       String? @db.Char(3)

  verification VerificationStatus @default(UNVERIFIED)
  verifiedAt   DateTime?

  // Karma is denormalised from Vote for cheap sorting; recomputed by a job.
  postKarma    Int @default(0)
  commentKarma Int @default(0)

  plan         PlanTier  @default(FREE)
  planExpiresAt DateTime?

  posts        Post[]
  comments     Comment[]
  votes        Vote[]
  calculations CalculationHistory[]
  leads        Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plan])
  @@index([verification])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Community
// ---------------------------------------------------------------------------

model Post {
  id      String @id @default(cuid())
  slug    String @unique
  title   String @db.VarChar(300)
  /// Markdown body. Rendered through a sanitising pipeline before display.
  content String @db.Text

  tags PostTag[]

  // When true the author is hidden in every read path. authorId is still stored
  // for rate-limiting and abuse handling, and must never be selected publicly.
  isAnonymous Boolean @default(false)
  /// Snapshot of the author's badge at posting time, so later profile edits
  /// don't rewrite history. Null when isAnonymous.
  authorBadge String?

  upvotes   Int @default(0)
  downvotes Int @default(0)
  /// Hot-rank cache: log10(score) weighted by age. Recomputed on vote.
  hotScore  Float @default(0)
  commentCount Int @default(0)
  viewCount    Int @default(0)

  moderation ModerationState @default(PUBLISHED)
  /// Reasons emitted by the PII/profanity validator, kept for appeal review.
  moderationNotes String[]

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Optional embedded calculator snapshot rendered as a card inside the post.
  embeddedCalculationId String?             @unique
  embeddedCalculation   CalculationHistory? @relation("PostEmbed", fields: [embeddedCalculationId], references: [id], onDelete: SetNull)

  comments Comment[]
  votes    Vote[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  @@index([hotScore(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([tags])
  @@index([authorId])
  @@map("posts")
}

model Comment {
  id      String @id @default(cuid())
  content String @db.Text

  isAnonymous Boolean @default(false)
  authorBadge String?

  upvotes   Int @default(0)
  downvotes Int @default(0)

  /// Materialised path, e.g. "0004.0001.0012". Lets a whole subtree load in a
  /// single indexed range query instead of N recursive round trips.
  path  String @default("")
  depth Int    @default(0)

  moderation ModerationState @default(PUBLISHED)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Self-referencing tree
  parentId String?
  parent   Comment?  @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentTree")

  votes Vote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, path])
  @@index([parentId])
  @@index([authorId])
  @@map("comments")
}

/// One row per (user, target). The partial unique constraints below are what
/// actually prevent vote manipulation — the app layer is not the guard.
model Vote {
  id    String    @id @default(cuid())
  value VoteValue

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, postId], name: "one_vote_per_post")
  @@unique([userId, commentId], name: "one_vote_per_comment")
  @@index([postId])
  @@index([commentId])
  @@map("votes")
}

// ---------------------------------------------------------------------------
// Calculators
// ---------------------------------------------------------------------------

/// Every calculator run is persisted: it powers re-sharing into the forum,
/// "your saved runs", and lead profiling for the sales funnel.
model CalculationHistory {
  id   String         @id @default(cuid())
  type CalculatorType

  /// Validated request payload (SkillArbitrageInput | RemotePayEquityInput).
  input Json
  /// Computed result payload, versioned so old snapshots stay renderable.
  result Json
  /// Bumped whenever the scoring model changes.
  engineVersion String @default("1.0.0")

  // Denormalised headline figures — indexed for analytics without JSON probing.
  headlineValue Decimal? @db.Decimal(12, 2)
  currencyCode  String?  @db.Char(3)
  countryCode   String?  @db.Char(2)
  employment    EmploymentStructure?

  /// Null for logged-out runs; anonymous sessions are stitched to a user on signup.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  sessionId String?

  /// True once the snapshot has been embedded in a public post.
  isShared Boolean @default(false)
  embeddedInPost Post? @relation("PostEmbed")

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([sessionId])
  @@map("calculation_history")
}

// ---------------------------------------------------------------------------
// Monetization
// ---------------------------------------------------------------------------

/// Captured at the gated-unlock modal. Kept separate from User so a lead can
/// exist without an account.
model Lead {
  id    String @id @default(cuid())
  email String

  currentRole     String?
  yearsExperience Int?

  /// Which asset was being unlocked, e.g. "negotiation-report-pdf".
  unlockedAsset String
  source        CalculatorType?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([email, unlockedAsset])
  @@index([createdAt(sort: Desc)])
  @@map("leads")
}

/// Affiliate inventory. Cards are matched to results by skillSlugs / countries.
model Partner {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  category String // "course" | "bootcamp" | "fx" | "eor" | "tax"
  blurb    String
  ctaLabel String
  url      String
  logoUrl  String?

  /// Match keys — a partner shows when a result mentions any of these.
  skillSlugs   String[]
  countryCodes String[]

  payoutModel String? // "CPA" | "RevShare" | "Flat"
  priority    Int     @default(0)
  isActive    Boolean @default(true)

  clicks PartnerClick[]

  createdAt DateTime @default(now())

  @@index([category, isActive])
  @@map("partners")
}

model PartnerClick {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  sessionId String?
  userId    String?
  placement String? // "skill-arbitrage-results" | "pay-equity-fx" ...

  createdAt DateTime @default(now())

  @@index([partnerId, createdAt(sort: Desc)])
  @@map("partner_clicks")
}
